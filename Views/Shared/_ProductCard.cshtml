@model ProductCatalog.Models.Product

@* Partial View: бір тауардың карточкасы *@
<div class="card h-100 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="badge bg-secondary">@Model.Category</span>
        <small class="text-muted">#@Model.Id</small>
    </div>
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text fs-5 fw-bold text-primary">@Model.Price.ToString("N0") ₸</p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            @if (Model.IsAvailable)
            {
                <span class="badge bg-success">Қоймада бар</span>
            }
            else
            {
                <span class="badge bg-danger">Қоймада жоқ</span>
            }
            <a class="btn btn-sm btn-outline-primary" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">Толығырақ</a>
        </div>
    </div>
</div>
